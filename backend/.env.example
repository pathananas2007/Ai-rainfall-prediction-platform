# MongoDB Atlas Connection String
# Get this from MongoDB Atlas: Cluster > Connect > Application Driver
# Format: mongodb+srv://username:password@cluster.mongodb.net/rainai?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/rainai?retryWrites=true&w=majority

# JWT Secret Key for token signing
# Use a strong random string in production
JWT_SECRET_KEY=your-strong-secret-key-change-this-in-production

# Frontend URL for CORS configuration
# In development: http://localhost:3000
# In production: https://your-vercel-domain.vercel.app
FRONTEND_URL=http://localhost:3000

# Google Gemini API Key (optional, uses fallback if not provided)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenWeather API Key (optional)
OPENWEATHER_API_KEY=your-openweather-api-key-here

# Environment (development or production)
ENV=development

# Port (Render sets this automatically in production)
PORT=5000
