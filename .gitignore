# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment files (NEVER commit these)
.env
.env.local
.env.production.local
.env.development.local
.env.test.local
.env/
venv/
env/
ENV/
.venv/

# VSCode settings (optional)
.vscode/

# Python cache / temporary files
*.pyo
*.pyd
*.pyc

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
Desktop.ini

# Logs
*.log

# CSV / output files (optional: if you want to keep your data private)
*.csv
*.sqlite3

# Spyder project settings (if using Spyder IDE)
.spyderproject
.spyproject

# Node modules (frontend)
node_modules/
frontend/node_modules/
frontend/dist/

# IDE
.idea/
*.swp
*.swo

# Keep ML model files (required for production)
!backend/ml/*.pkl
